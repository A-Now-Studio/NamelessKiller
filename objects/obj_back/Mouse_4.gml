
if (instance_exists(obj_volume_down)) {
	obj_volume_down.x_target = -room_width
}
if (instance_exists(obj_volume_up)) {
	obj_volume_up.x_target = -room_width
}
if (instance_exists(obj_volume_display)) {
	obj_volume_display.x_target = -room_width
}
if (instance_exists(obj_volume_text)) {
	obj_volume_text.x_target = -room_width
}
if (instance_exists(obj_back)) {
    obj_back.x_target = -room_width; 
}
if (instance_exists(obj_fullscreen)) {
    obj_fullscreen.x_target = -room_width; 
}
if (instance_exists(obj_play)) {
    obj_play.x_target = 1;
}
if (instance_exists(obj_options)) {
    obj_options.x_target = 1;
}
if (instance_exists(obj_quit)) {
    obj_quit.x_target = 1;
}
